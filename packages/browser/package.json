{
  "name": "@xiaobaibaifqy/jingchuanchu-browser",
  "version": "0.4.0",
  "description": "Jingchuanchu (\u955c\u5ddd\u521d) TypeScript engine browser module",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": {
        "types": "./index.ts",
        "default": "./index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "source": {
        "types": "./dom.ts",
        "default": "./dom.ts"
      },
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    }
  },
  "files": [
    "dist",
    "*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@xiaobaibaifqy/jingchuanchu-core": "^0.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
