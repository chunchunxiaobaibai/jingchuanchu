{
  "name": "@xiaobaibaifqy/jingchuanchu-assets",
  "version": "0.3.0",
  "description": "Jingchuanchu (镜川初) TypeScript engine assets module",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": {
        "types": "./index.ts",
        "default": "./index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "source": {
        "types": "./module.ts",
        "default": "./module.ts"
      },
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@xiaobaibaifqy/jingchuanchu-core": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-ecs": "^0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
