{
  "name": "@xiaobaibaifqy/jingchuanchu-tooling",
  "version": "0.4.0",
  "description": "Jingchuanchu component compiler and project generator",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jingchuanchu": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.mjs"
    }
  },
  "files": [
    "dist",
    "*.mjs",
    "*.d.ts",
    "*.d.mts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "typescript": "^5.9.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "less": "^4.2.0",
    "magic-string": "^0.30.0",
    "postcss-import": "^16.1.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
