{
  "name": "@xiaobaibaifqy/jingchuanchu-app",
  "version": "0.4.0",
  "description": "Jingchuanchu typed application, scene, input and view runtime",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
