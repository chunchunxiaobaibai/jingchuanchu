{
  "name": "@xiaobaibaifqy/jingchuanchu-core",
  "version": "0.4.0",
  "description": "Jingchuanchu (镜川初) TypeScript engine core module",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": {
        "types": "./index.ts",
        "default": "./index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scenes": {
      "source": {
        "types": "./scenes.ts",
        "default": "./scenes.ts"
      },
      "types": "./dist/scenes.d.ts",
      "default": "./dist/scenes.js"
    }
  },
  "files": [
    "dist",
    "*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@xiaobaibaifqy/jingchuanchu-ecs": "^0.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
