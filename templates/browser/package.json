    "@xiaobaibaifqy/jingchuanchu-input": "*",
    "@xiaobaibaifqy/jingchuanchu-renderer-2d": "*",
    "@xiaobaibaifqy/jingchuanchu-app": "^0.4.0"
  },
  "devDependencies": {
    "parse5": "^8.0.0",
    "postcss": "^8.5.0",
    "postcss-selector-parser": "^7.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@xiaobaibaifqy/jingchuanchu-tooling": "^0.4.0"
  },
