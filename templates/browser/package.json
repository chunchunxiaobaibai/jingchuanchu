  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "check:structure": "node scripts/check-project.mjs",
    "check": "npm run check:structure && jingchuanchu check && tsc --noEmit",
