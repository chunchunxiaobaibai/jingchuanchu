{
  "name": "jingchuanchu-engine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:packages": "npm run pack:packages && tsx scripts/verify-packages.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=source --test tests/*.test.ts",
    "build": "npm run typecheck && npm run build:packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "tsx scripts/build-packages.ts",
    "pack:packages": "npm run build:packages && tsx scripts/pack-packages.ts",
    "dist:release": "npm run typecheck && npm run pack:packages && tsx scripts/distribution/build.ts",
    "test:distribution": "npm run dist:release && tsx scripts/distribution/verify.ts"
  },
  "dependencies": {
    "@xiaobaibaifqy/jingchuanchu-ecs": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-core": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-renderer-2d": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-input": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-assets": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-browser": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-net": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-net-server": "^0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT"
}
