{
  "name": "jingchuanchu-engine",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:packages": "npm run pack:packages && tsx scripts/verify/packages.ts",
    "test:project": "tsx --conditions=source --test tests/project-structure.test.ts tests/template-game.test.ts",
    "check:templates": "node templates/browser/scripts/check-project.mjs templates/browser && node packages/tooling/cli.mjs check templates/browser && tsc -p templates/browser/tsconfig.json",
    "test:template": "tsx scripts/verify/template.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=source --test tests/*.test.ts",
    "build": "npm run typecheck && npm run build:packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "tsx scripts/build/packages.ts",
    "pack:packages": "npm run build:packages && tsx scripts/build/pack.ts",
    "dist:release": "npm run docs:build && npm run docs:check && npm run typecheck && npm run pack:packages && npm run check:templates && tsx scripts/distribution/build.ts",
    "test:distribution": "npm run dist:release && tsx scripts/distribution/verify.ts",
    "test:api": "tsx scripts/verify/api.ts",
    "test:2d": "tsx scripts/verify/2d.ts",
    "test:endurance": "tsx --conditions=source scripts/verify/endurance-check.ts",
    "test:e2e:endurance": "playwright test tests/e2e/endurance.test.ts --project=chromium --timeout=600000",
    "benchmark": "tsx --conditions=source scripts/benchmarks/core.ts",
    "benchmark:native": "tsx --conditions=source scripts/benchmarks/native.ts",
    "benchmark:hot-paths": "tsx --conditions=source scripts/benchmarks/hot-paths.ts",
    "benchmark:browser": "tsx --conditions=source scripts/benchmarks/browser.ts",
    "benchmark:isolated": "tsx --conditions=source scripts/benchmarks/isolated.ts",
    "test:distribution:node": "npm run dist:release && tsx scripts/distribution/verify.ts --skip-browser",
    "test:app": "tsx --conditions=source --test tests/app*.test.ts",
    "test:app:distribution": "npm run test:app:package",
    "test:app:package": "tsx scripts/verify/application-package.ts",
    "docs:build": "node scripts/docs/site.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:dev": "node scripts/docs/serve.mjs"
  },
  "dependencies": {
    "@xiaobaibaifqy/jingchuanchu-assets": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-browser": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-core": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-ecs": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-input": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-net": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-net-server": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-renderer-2d": "^0.6.0",
    "@xiaobaibaifqy/jingchuanchu-app": "^0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@xiaobaibaifqy/jingchuanchu-tooling": "^0.6.0",
    "happy-dom": "^20.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT"
}
