{
  "name": "jingchuanchu-engine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:packages": "npm run pack:packages && tsx scripts/verify-packages.ts",
    "preview:singleplayer": "vite preview --config vite.singleplayer.config.ts --host 0.0.0.0 --port 4174",
    "dev": "concurrently -k -n server,client \"tsx watch --conditions=source apps/server/main.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=source --test tests/*.test.ts",
    "build": "npm run typecheck && npm run build:packages && vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/apps/server/main.js",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "tsx scripts/build-packages.ts",
    "dev:singleplayer": "vite --config vite.singleplayer.config.ts",
    "build:singleplayer": "vite build --config vite.singleplayer.config.ts",
    "pack:packages": "npm run build:packages && tsx scripts/pack-packages.ts",
    "dist:release": "npm run typecheck && npm run pack:packages && tsx scripts/distribution/build.ts",
    "test:distribution": "npm run dist:release && tsx scripts/distribution/verify.ts"
  },
  "dependencies": {
    "zod": "^4.0.0",
    "@xiaobaibaifqy/jingchuanchu-ecs": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-core": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-renderer-2d": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-input": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-assets": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-browser": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-net": "^0.3.0",
    "@xiaobaibaifqy/jingchuanchu-net-server": "^0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT"
}
