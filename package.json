{
  "name": "xiaobaifqy-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch apps/server/main.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/apps/server/main.js",
    "test:e2e": "playwright test"
  },
  "dependencies": { "ws": "^8.18.0", "zod": "^4.0.0" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": { "node": ">=22.12.0" }
}
